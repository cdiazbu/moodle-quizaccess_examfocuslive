{{!
    @template quizaccess_examfocuslive/student_cards

    Live student cards for the compact and detailed dashboard views.

    Example context (json):
    {
        "cards": [
            {
                "compact": true,
                "userid": 1,
                "state": "active",
                "showname": true,
                "name": "Example student",
                "status": "Active",
                "haspage": true,
                "page": "Page 1",
                "progresslabel": "50%"
            }
        ]
    }
}}
{{#cards}}
<article class="{{#compact}}efl-tile efl-tile--{{state}}{{#blurred}} efl-tile--blurred{{/blurred}}{{/compact}}{{^compact}}efl-card efl-card--{{state}}{{#paused}} is-alert{{/paused}}{{/compact}}"
         data-student-card="{{userid}}">
    {{#compact}}
        <header class="efl-tile-heading">
            {{#showphoto}}<img src="{{pictureurl}}" alt="" loading="lazy">{{/showphoto}}
            <h2 class="{{^showname}}sr-only{{/showname}}" title="{{#showname}}{{name}}{{/showname}}">{{name}}</h2>
            {{#hasincidents}}
                <span class="efl-tile-incidents" title="{{incidentslabel}}"
                      aria-label="{{incidentslabel}}: {{incidents}}">!{{incidents}}</span>
            {{/hasincidents}}
        </header>
        <div class="efl-tile-status"><span>{{status}}</span><span>{{progresslabel}}</span></div>
        {{#haspage}}
            <div class="efl-tile-meta"><span title="{{questionlabel}}">{{page}}</span><span>{{lastseen}}</span></div>
        {{/haspage}}
    {{/compact}}
    {{^compact}}
        {{#paused}}
            <div class="efl-card__alertbar"><span aria-hidden="true">!</span>{{alertlabel}}</div>
        {{/paused}}
        <div class="efl-card__top">
            <div class="efl-identity {{^showphoto}}efl-identity--no-photo{{/showphoto}}">
                {{#showphoto}}<div class="efl-avatar"><img src="{{pictureurl}}" alt=""><i></i></div>{{/showphoto}}
                <div class="efl-identity__copy">
                    <h2 class="{{^showname}}sr-only{{/showname}}">{{name}}</h2>
                    <span class="efl-status"><i></i>{{status}}</span>
                </div>
            </div>
            {{#hasprogress}}
                <div class="efl-progress" style="--progress:{{progress}}" aria-label="{{progress}}%">
                    <span>{{progress}}<small>%</small></span>
                </div>
            {{/hasprogress}}
            {{^hasprogress}}<span class="efl-progress-na">—</span>{{/hasprogress}}
        </div>
        <div class="efl-card__details">
            <div><span>{{locationlabel}}</span><strong>{{location}}</strong></div>
            <div><span>{{elapsedlabel}}</span><strong class="efl-mono">{{elapsed}}</strong></div>
            <div><span>{{incidentslabel}}</span><strong class="{{#hasincidents}}efl-danger{{/hasincidents}}">{{incidents}}</strong></div>
            <div><span>{{lastseenlabel}}</span><strong>{{lastseen}}</strong></div>
        </div>
    {{/compact}}
    {{#controls}}
        <div class="efl-card__actions">
            <label class="efl-select-attempt" title="{{selectlabel}}">
                <input type="checkbox" data-select-attempt data-attempt="{{attemptid}}" aria-label="{{selectlabel}}"{{#selected}} checked{{/selected}}>
            </label>
            {{#buttons}}
                <button type="button" class="efl-button efl-button--{{action}}" data-action="{{action}}" data-attempt="{{attemptid}}">
                    <span aria-hidden="true">{{icon}}</span>{{label}}
                </button>
            {{/buttons}}
        </div>
    {{/controls}}
</article>
{{/cards}}
